{
  "entities": {
    "Submission": {
      "title": "Submission",
      "description": "수료증 제출 정보 내역 및 확인용 엔티티",
      "type": "object",
      "properties": {
        "assistantName": {
          "type": "string",
          "description": "활동지원사 성명"
        },
        "birthDate": {
          "type": "string",
          "description": "생년월일 (YYMMDD 형식)"
        },
        "certificateImage": {
          "type": "string",
          "description": "수료증 이미지 원본 (Base64 형식)"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "제출 일시"
        },
        "isCompleted": {
          "type": "boolean",
          "description": "승인 완료 여부"
        },
        "trainingHours": {
          "type": "string",
          "description": "이수 시간"
        },
        "courseName": {
          "type": "string",
          "description": "수강 과정명"
        },
        "managerNotes": {
          "type": "string",
          "description": "관리자 메모"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "관리자 검토 일시"
        }
      },
      "required": [
        "assistantName",
        "birthDate",
        "certificateImage",
        "submittedAt",
        "isCompleted"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "관리자 계정 엔티티",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "관리자 성명"
        },
        "password": {
          "type": "string",
          "description": "관리자 비밀번호"
        }
      },
      "required": [
        "name",
        "password"
      ]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "시스템 공통 설정 (Gemini API 키 등)",
      "type": "object",
      "properties": {
        "geminiApiKey": {
          "type": "string",
          "description": "Google Gemini API 키"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "설정 갱신 일시"
        }
      }
    }
  },
  "firestore": {
    "submissions/{submissionId}": {
      "schema": "Submission",
      "description": "사용자가 제출한 수료증 목록"
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "등록된 관리자 계정 목록"
    },
    "settings/{settingId}": {
      "schema": "AppSetting",
      "description": "애플리케이션 전역 설정 정보"
    }
  }
}
